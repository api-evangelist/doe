{
  "opencollection": "1.0.0",
  "info": {
    "name": "EIA APIv2 AEO Root API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Root",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /v2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eia.gov/v2"
          }
        }
      ]
    }
  ],
  "bundled": true
}